[Unit]
Description=Sync the rolling YuHai Voc report to the existing Feishu Base
After=network-online.target qiyu-console.service
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=qiyu
Group=qiyu
WorkingDirectory=/opt/qiyu-console
EnvironmentFile=-/opt/qiyu-console/.env
EnvironmentFile=-/var/cache/qiyu-voc/runtime.env
Environment=YUHAI_FEISHU_SYNC_CONFIG=/var/lib/qiyu-feishu-sync/target-config.json
Environment=LARKSUITE_CLI_CONFIG_DIR=/var/lib/qiyu-feishu-sync/lark-config
Environment=LARKSUITE_CLI_DATA_DIR=/var/lib/qiyu-feishu-sync/lark-data
StateDirectory=qiyu-feishu-sync
StateDirectoryMode=0700
ExecStart=/opt/qiyu-voc-venv/bin/python -B -u /opt/qiyu-console/deploy/feishu_sync/run.py --state-dir /var/lib/qiyu-feishu-sync --apply
Restart=on-failure
RestartSec=5min
TimeoutStartSec=4min
UMask=0077
NoNewPrivileges=true
